) %>%
addControl(
html = "<div style='background: rgba(255,255,255,0.95); padding: 12px;
border-radius: 8px; border-left: 5px solid #27ae60;'>
<h3 style='margin: 0; color: #2c3e50; font-size: 16px;'>
✓ Efectividad y Culminación</h3>
<p style='margin: 5px 0 0 0; font-size: 12px; color: #7f8c8d;'>
Áreas = Ratio efectividad | Círculos = % culminados</p>
</div>",
position = "topleft"
) %>%
addScaleBar(position = "bottomleft")
cat("✓ Mapa 4 generado exitosamente\n")
# ==============================================================================
# MAPA 5: HEATMAP DE INTENSIDAD
# ==============================================================================
cat("\n=== Generando Mapa 5: Heatmap ===\n")
# Preparar centroides con proyectos
centroides_proyectos <- datos_mapa_completo %>%
filter(total_proyectos > 0) %>%
st_centroid()
# Crear matriz para heatmap (ponderar por proyectos × efectividad)
puntos_heatmap <- tryCatch({
do.call(rbind, lapply(1:nrow(centroides_proyectos), function(i) {
n_rep <- max(1, ceiling(centroides_proyectos$total_proyectos[i] *
coalesce(centroides_proyectos$efectividad_promedio[i], 1)))
coords <- st_coordinates(centroides_proyectos[i,])
data.frame(
lng = rep(coords[1], n_rep),
lat = rep(coords[2], n_rep)
)
}))
}, error = function(e) {
# Fallback: usar solo centroides
coords <- st_coordinates(centroides_proyectos)
data.frame(lng = coords[,1], lat = coords[,2])
})
mapa_heatmap <- leaflet() %>%
addProviderTiles(providers$CartoDB.DarkMatter) %>%
# Base: parroquias con transparencia
addPolygons(
data = datos_mapa_completo,
fillColor = "#34495e",
fillOpacity = 0.3,
color = "#7f8c8d",
weight = 0.5,
popup = datos_mapa_completo$popup_hotspot
) %>%
# Heatmap
addHeatmap(
data = puntos_heatmap,
lng = ~lng,
lat = ~lat,
intensity = 1,
blur = 25,
max = 0.8,
radius = 15,
gradient = list(
'0' = 'navy',
'0.25' = 'blue',
'0.5' = 'cyan',
'0.75' = 'yellow',
'1' = 'red'
),
group = "Heatmap Intensidad"
) %>%
# Centros poblados pequeños
addCircleMarkers(
data = centros_wgs,
radius = 3,
color = "#ecf0f1",
fillColor = "#bdc3c7",
fillOpacity = 0.6,
weight = 1,
group = "Centros Poblados"
) %>%
# Parroquias destacadas (4+ proyectos)
addCircleMarkers(
data = centroides_proyectos %>% filter(total_proyectos >= 4),
radius = ~sqrt(total_proyectos) * 4,
color = "#e74c3c",
fillColor = "#c0392b",
fillOpacity = 0.8,
weight = 2,
popup = ~popup_hotspot,
label = ~paste0(PARROQUIA, " - ", total_proyectos, " proyectos"),
group = "Parroquias Top"
) %>%
addLayersControl(
overlayGroups = c("Heatmap Intensidad", "Centros Poblados", "Parroquias Top"),
options = layersControlOptions(collapsed = FALSE)
) %>%
addControl(
html = "<div style='background: rgba(44,62,80,0.95); padding: 12px;
border-radius: 8px; border-left: 5px solid #e74c3c;'>
<h3 style='margin: 0; color: #ecf0f1; font-size: 16px;'>
Mapa de Calor: Intensidad Territorial</h3>
<p style='margin: 5px 0 0 0; font-size: 12px; color: #bdc3c7;'>
Densidad ponderada por volumen y efectividad</p>
</div>",
position = "topleft"
) %>%
addScaleBar(position = "bottomleft")
